<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop player's mark stood on end, as this app's flow is, on the player's backdrop: the launcher crops every
     icon to its own shape, so it gets one to crop rather than a transparent square. The foreground is rendered at
     build time (see build.gradle.kts). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
